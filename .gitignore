# Build artifacts
./build/*
build/*
fast_cd_pyb.egg-info/*
**.pyd
dist/*
.vscode/*
**.DMAT
./cache/*
./results/*
results/*
**.npy
**.blend
**.blend1

# Architecture-specific compiled files (M1/ARM64, Intel/x86_64)
# Exclude all .so files (shared objects) - these are architecture-specific
**/*.so
**/*.dylib
**/*.dll

# Python compiled extensions (architecture-specific)
**/*.cpython-*-darwin.so
**/*.cpython-*-linux.so
**/*.cpython-*-win*.so

# Build directories with architecture-specific paths
build/**/macosx-*-arm64*
build/**/macosx-*-x86_64*
build/**/temp.macosx-*
build/**/lib.macosx-*
**/build/**/macosx-*
**/build/**/temp.*
**/build/**/lib.*

# CMake build artifacts
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt

# Python cache
**.pyc
src/fast_cody/__pycache__/*
src/fast_cody/examples/__pycache__/*
src/fast_cody/apps/__pycache__/*

# macOS-specific files
.DS_Store
**/.DS_Store
*.DS_Store

results/**
**.ini

site/*
site/**

# ============================================
# API KEYS AND CREDENTIALS
# ============================================
# Environment files with API keys
.env
.env.local
.env.*.local
*.env
.envrc

# Config files that might contain API keys
config.ini
config.local.ini
secrets.json
credentials.json
*.key
*.pem
*.p12
*.pfx

# Common credential storage locations
.credentials/
secrets/
*.secret

# ============================================
# LARGE MODEL FILES
# ============================================
# 3D model formats (can be very large)
**.msh
**.obj
**.glb
**.gltf
**.fbx
**.dae
**.3ds
**.ply
**.stl
**.blend
**.blend1

# Generated outputs (often contain large models)
outputs/**
!outputs/.gitkeep

# Large data directories (uncomment if you want to ignore data/ models)
# data/**/*.msh
# data/**/*.obj
# data/**/*.glb

# Large texture files (only in outputs, keep data/ textures)
outputs/**/*.png
outputs/**/*.jpg
outputs/**/*.jpeg
outputs/**/*.tiff
outputs/**/*.tif
outputs/**/*.exr
outputs/**/*.hdr
# If you want to ignore ALL texture files, uncomment below and comment above:
# **.png
# **.jpg
# **.jpeg
# **.tiff
# **.tif
# **.exr
# **.hdr

# Archive files
**.zip
**.tar
**.tar.gz
**.rar
**.7z

# Large cache and temporary files
cache/**
*.cache
*.tmp
*.temp
# Environment variables
.env
